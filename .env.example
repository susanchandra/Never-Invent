# NeverInvent — Environment Variables
# Copy this to .env and fill in values. Never commit .env to source control.

# Optional: Groq API key for LLM generation (Phase 2+). Not required for core verification.
# GROQ_API_KEY=your_groq_api_key_here

# Application settings
APP_ENV=development
LOG_LEVEL=INFO

# Database (SQLite path)
DATABASE_URL=sqlite:///./neverinvent.db
